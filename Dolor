function Targeting:IsTeammate(player)
    local localPlayer = Services.Players.LocalPlayer
    if player.Team and localPlayer.Team and player.Team == localPlayer.Team then
        return true
    end
    local myTeam = localPlayer:GetAttribute("Team")
    local theirTeam = player:GetAttribute("Team")
    if myTeam and theirTeam and myTeam == theirTeam then
        return true
    end
    return false
end

function Targeting:IsVisible(targetPart)
    if not self.Config.VisibilityCheck then return true end
    local camera = workspace.CurrentCamera
    local localPlayer = Services.Players.LocalPlayer
    
    local success, result = pcall(function()
        local rayParams = RaycastParams.new()
        rayParams.FilterDescendantsInstances = {localPlayer.Character}
        rayParams.FilterType = Enum.RaycastFilterType.Blacklist
        return workspace:Raycast(camera.CFrame.Position, (targetPart.Position - camera.CFrame.Position).Unit * 1000, rayParams)
    end)
    
    if not success or not result then return true end
    return result.Instance:IsDescendantOf(targetPart.Parent)
end

function Targeting:FindTarget()
    if not self.Config.Enabled then return nil end
    
    local localPlayer = Services.Players.LocalPlayer
    local camera = workspace.CurrentCamera
    local mousePos = Services.UserInputService:GetMouseLocation()
    
    local bestTarget = nil
    local bestScore = math.huge
    
    for _, player in ipairs(Services.Players:GetPlayers()) do
        if player == localPlayer then continue end
        if self.Config.TeamCheck and self:IsTeammate(player) then continue end
        
        local character = player.Character
        if not character then continue end
        
        local targetPart = character:FindFirstChild(self.Config.TargetPart)
        local humanoid = character:FindFirstChild("Humanoid")
        if not targetPart or not humanoid or humanoid.Health <= 0 then continue end
        
        if not self:IsVisible(targetPart) then continue end
        
        local screenPos, onScreen = camera:WorldToViewportPoint(targetPart.Position)
        if not onScreen or screenPos.Z < 0 then continue end
        
        local screenVec = Vector2.new(screenPos.X, screenPos.Y)
        local dist = (screenVec - mousePos).Magnitude
        if dist > self.Config.FOV then continue end
        
        if math.random(1, 100) > self.Config.Hitchance then continue end
        
        local score = dist
        if self.LastTarget and player == self.LastTarget.Player then
            score = score * self.Config.Stickiness
        end
        score = score - (100 - humanoid.Health) * 0.5
        
        if score < bestScore then
            bestScore = score
            bestTarget = {
                Player = player,
                Part = targetPart,
                Humanoid = humanoid,
                Position = targetPart.Position,
                Velocity = targetPart.AssemblyLinearVelocity,
                ScreenPos = screenVec,
                Distance = dist,
                Health = humanoid.Health,
                MaxHealth = humanoid.MaxHealth
            }
        end
    end
    
    if self.LastTarget and bestTarget and self.LastTarget.Player ~= bestTarget.Player then
        if tick() - self.LastSwitch < 0.1 then
            return self.LastTarget
        end
    end
    
    if bestTarget then self.LastSwitch = tick() end
    self.LastTarget = bestTarget
    self.CurrentTarget = bestTarget
    return bestTarget
end

function Targeting:Predict(target)
    if not self.Config.Prediction or not target then
        return target and target.Position or nil
    end
    
    local velocity = target.Velocity or Vector3.new()
    local distance = target.Distance or 100
    local bulletSpeed = 1000
    local timeToHit = distance / bulletSpeed
    
    local predicted = target.Position + (velocity * timeToHit)
    if self.Config.BulletDrop then
        predicted = predicted - Vector3.new(0, 0.5 * 9.81 * timeToHit^2, 0)
    end
    
    predicted = predicted + Vector3.new(
        (math.random() - 0.5) * 0.03,
        (math.random() - 0.5) * 0.03,
        (math.random() - 0.5) * 0.03
    )
    
    return predicted
end

-- // [COMBAT: AIM CONTROLLER - 3 MODES]
local AimController = {
    Config = {
        Smoothness = 0.08,
        Mode = "Silent",
        Randomization = 0.02
    }
}

function AimController:LegitAim(targetPos)
    if not targetPos then return end
    local camera = workspace.CurrentCamera
    local mousePos = Services.UserInputService:GetMouseLocation()
    local screenPos = camera:WorldToViewportPoint(targetPos)
    local targetScreen = Vector2.new(screenPos.X, screenPos.Y)
    
    local delta = targetScreen - mousePos
    local smooth = self.Config.Smoothness
    if delta.Magnitude > 100 then smooth = smooth * 1.5 end
    if delta.Magnitude < 20 then smooth = smooth * 0.5 end
    delta = delta * smooth
    
    local steps = math.random(2, 4)
    for i = 1, steps do
        local step = delta / steps
        pcall(function() mousemoverel(step.X, step.Y) end)
        task.wait(math.random(1, 3) / 1000)
    end
end

function AimController:SilentAim(targetPos)
    if not targetPos then return end
    local mt = getrawmetatable(game)
    local oldNamecall = mt.__namecall
    
    setreadonly(mt, false)
    local hooked = false
    
    mt.__namecall = function(self, ...)
        if hooked then return oldNamecall(self, ...) end
        hooked = true
        
        local method = getnamecallmethod()
        if method == "FireServer" or method == "InvokeServer" then
            local args = {...}
            for i, arg in ipairs(args) do
                if typeof(arg) == "Vector3" then
                    args[i] = targetPos
                elseif typeof(arg) == "CFrame" then
                    args[i] = CFrame.new(targetPos)
                end
            end
            return oldNamecall(self, table.unpack(args))
        end
        return oldNamecall(self, ...)
    end
    
    setreadonly(mt, true)
    task.delay(0, function()
        setreadonly(mt, false)
        mt.__namecall = oldNamecall
        setreadonly(mt, true)
    end)
end

function AimController:Aim(targetPos)
    if self.Config.Mode == "Silent" then
        self:SilentAim(targetPos)
    elseif self.Config.Mode == "Legit" then
        self:LegitAim(targetPos)
    elseif self.Config.Mode == "Blatant" then
        pcall(function()
            local camera = workspace.CurrentCamera
            local screenPos = camera:WorldToViewportPoint(targetPos)
            local mousePos = Services.UserInputService:GetMouseLocation()
            mousemoverel(screenPos.X - mousePos.X, screenPos.Y - mousePos.Y)
        end)
    end
end

-- // [VISUAL: ESP ENGINE - ENHANCED]
local ESP = {
    Config = {
        Enabled = false,
        Boxes = true,
        Names = true,
        Health = true,
        Distance = true,
        Tracers = false,
        TeamCheck = true,
        MaxDistance = 2000,
        RefreshRate = 1/60,
        PreviewMode = false
    },
    LastUpdate = 0,
    RenderData = {}
}

function ESP:Update()
    if not self.Config.Enabled then
        for _, data in ipairs(self.RenderData) do
            if data.Object then DrawPool:Release(data.Object) end
        end
        table.clear(self.RenderData)
        return
    end
    
    local now = tick()
    if now - self.LastUpdate < self.Config.RefreshRate then return end
    self.LastUpdate = now
    
    for _, data in ipairs(self.RenderData) do
        if data.Object then DrawPool:Release(data.Object) end
    end
    table.clear(self.RenderData)
    
    local camera = workspace.CurrentCamera
    local localPlayer = Services.Players.LocalPlayer
    local screenCenter = Vector2.new(camera.ViewportSize.X / 2, camera.ViewportSize.Y)
    
    for _, player in ipairs(Services.Players:GetPlayers()) do
        if player == localPlayer then continue end
        if self.Config.TeamCheck and player.Team == localPlayer.Team then continue end
        
        local character = player.Character
        if not character then continue end
        
        local head = character:FindFirstChild("Head")
        local hrp = character:FindFirstChild("HumanoidRootPart")
        local humanoid = character:FindFirstChild("Humanoid")
        if not head or not hrp or not humanoid or humanoid.Health <= 0 then continue end
        
        local headPos, headVis = camera:WorldToViewportPoint(head.Position)
        if not headVis or headPos.Z < 0 then continue end
        
        local hrpPos, hrpVis = camera:WorldToViewportPoint(hrp.Position)
        if not hrpVis or hrpPos.Z < 0 then continue end
        
        local distance = (hrp.Position - camera.CFrame.Position).Magnitude
        if distance > self.Config.MaxDistance then continue end
        
        local obj, idx = DrawPool:Acquire()
        if not obj then break end
        
        local screenHead = Vector2.new(headPos.X, headPos.Y)
        local screenHrp = Vector2.new(hrpPos.X, hrpPos.Y)
        local height = math.abs(screenHead.Y - screenHrp.Y) * 1.3
        local width = height * 0.6
        
        if self.Config.Boxes then
            obj.Box.Size = Vector2.new(width, height)
            obj.Box.Position = Vector2.new(screenHrp.X - width / 2, screenHrp.Y - height / 2)
            obj.Box.Color = CurrentTheme.Secondary
            obj.Box.Thickness = 1.5
            obj.Box.Filled = false
            obj.Box.Visible = true
        end
        
        if self.Config.Names then
            local text = player.Name
            if self.Config.Distance then
                text = string.format("%s [%dm]", text, math.floor(distance))
            end
            obj.Name.Text = text
            obj.Name.Position = Vector2.new(screenHead.X, screenHead.Y - 25)
            obj.Name.Color = CurrentTheme.Light
            obj.Name.Size = 13
            obj.Name.Center = true
            obj.Name.Outline = true
            obj.Name.Visible = true
        end
        
        if self.Config.Health then
            local healthPercent = math.clamp(humanoid.Health / humanoid.MaxHealth, 0, 1)
            local barWidth = 4
            local barHeight = height
            
            obj.HealthBg.Size = Vector2.new(barWidth, barHeight)
            obj.HealthBg.Position = Vector2.new(screenHrp.X - width / 2 - barWidth - 2, screenHrp.Y - height / 2)
            obj.HealthBg.Color = CurrentTheme.Dark
            obj.HealthBg.Filled = true
            obj.HealthBg.Visible = true
            
            obj.HealthBar.Size = Vector2.new(barWidth, barHeight * healthPercent)
            obj.HealthBar.Position = Vector2.new(screenHrp.X - width / 2 - barWidth - 2, screenHrp.Y - height / 2 + barHeight * (1 - healthPercent))
            obj.HealthBar.Color = Color3.fromRGB(math.floor(255 * (1 - healthPercent)), math.floor(255 * healthPercent), 100)
            obj.HealthBar.Filled = true
            obj.HealthBar.Visible = true
        end
        
        if self.Config.Tracers then
            obj.Tracer.From = screenCenter
            obj.Tracer.To = screenHrp
            obj.Tracer.Color = CurrentTheme.Secondary
            obj.Tracer.Thickness = 1
            obj.Tracer.Visible = true
        end
        
        table.insert(self.RenderData, {Object = obj, Player = player})
    end
end

