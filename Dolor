function UISystem:CreateWindow(title)
    Logger:Info("UI System initialized - " .. title)
end

function UISystem:AddTab(name)
    self.Tabs[name] = {
        name = name,
        elements = {}
    }
end

function UISystem:AddButton(tab, label, callback)
    if not self.Tabs[tab] then return end
    table.insert(self.Tabs[tab].elements, {
        type = "button",
        label = label,
        callback = callback
    })
end

function UISystem:AddToggle(tab, label, default, callback)
    if not self.Tabs[tab] then return end
    table.insert(self.Tabs[tab].elements, {
        type = "toggle",
        label = label,
        value = default,
        callback = callback
    })
end

function UISystem:AddSlider(tab, label, min, max, default, callback)
    if not self.Tabs[tab] then return end
    table.insert(self.Tabs[tab].elements, {
        type = "slider",
        label = label,
        min = min,
        max = max,
        value = default,
        callback = callback
    })
end

